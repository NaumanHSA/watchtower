# Copy to .env and edit. Every worker setting is documented in docs/configuration.md.

# ---- Controller ----
CONTROLLER_URL=https://watchtower.example.com
# A token with the worker role, from your token server:
#   watchtower-token-server issue --role worker --subject site-a
WATCHTOWER_TOKEN=
WORKER_NAME=site-a-1
MAX_STREAMS=4

# ---- Live view ----
# This host's address as viewers' browsers see it.
PUBLIC_HOST=203.0.113.10
PUBLIC_WEBRTC_URL=http://203.0.113.10:8889

# Viewers behind strict NAT need a TURN relay. MediaMTX hands these to authorised viewers.
# MTX_WEBRTCICESERVERS2_0_URL=turn:turn.example.com:3478
# MTX_WEBRTCICESERVERS2_0_USERNAME=watchtower
# MTX_WEBRTCICESERVERS2_0_PASSWORD=CHANGE_ME

# ---- Results ----
# realtime: never late, drops stale results under pressure
# reliable: never drops (up to SPOOL_MAX_MB on disk), may deliver late
DELIVERY_MODE=realtime
# Refuse to send results unencrypted if the token server provides no key.
REQUIRE_ENCRYPTION=true
# Fallback when neither the stream nor the controller sets a results URL.
# RESULTS_URL=https://your-app.example.com/watchtower/events

# ---- Engine ----
# ENGINE_INPUT=mediamtx      # or direct: the engine opens the camera itself
# DETECTOR_BACKEND=onnx      # or opencv
# ON_LEASE_EXPIRY=keep_running   # or stop: stop streams when the controller is unreachable for a lease

LOG_FORMAT=json
