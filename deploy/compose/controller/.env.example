# Copy to .env and edit. Every controller setting is documented in docs/configuration.md.

# ---- Authentication ----
# http: ask a token server (the bundled one: run with --profile token-server)
AUTH_PROVIDER=http
TOKEN_SERVER_URL=http://token-server:9000/v1/token/verify
# static: list tokens here instead of running a token server, as role:token pairs
# AUTH_PROVIDER=static
# STATIC_TOKENS=admin:CHANGE_ME_LONG_RANDOM,worker:CHANGE_ME_LONG_RANDOM
# RESULT_PUBLIC_KEY_FILE=/run/secrets/results-public.pem

# ---- Results ----
# Where workers POST detections unless a stream overrides it. With the bundled token
# server you can point this at it and have it decrypt + forward to your app.
RESULTS_URL=
# TOKEN_SERVER_INGEST_ENABLED=true
# TOKEN_SERVER_FORWARD_URL=https://your-app.example.com/watchtower/events

# ---- Bundled token server (profile token-server) ----
# Enables the admin HTTP API. Generate with: openssl rand -hex 32
TOKEN_SERVER_ADMIN_KEY=
# Encrypts the results private keys at rest. Generate with:
#   docker compose run --rm token-server gen-master-key
TOKEN_SERVER_MASTER_KEY=

# ---- Operations ----
LOG_FORMAT=json
# CORS_ALLOW_ORIGINS=https://dashboard.example.com
# REDIS_URL=redis://redis:6379/0     # only when running several controller replicas

# ---- HTTPS (profile tls) ----
# DOMAIN=watchtower.example.com
