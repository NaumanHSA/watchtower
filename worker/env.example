# Environment File
# LOGS
LOGS_LEVEL=info

# APP
APP_NAME="Video Worker"

# NETWORK
HOST_WORKER_URL="http://localhost:8081/"
HOST_MTX_WEBRTC_URL="http://localhost:18889"
CONTROLLER_URL="http://host.docker.internal:7000/"
# BROADCAST_URL="http://host.docker.internal:9000/ingest/encrypted"

# Auth
WORKER_API_KEY=worker-api-key-1234567890
WATCHTOWER_TOKEN=watchtower-token-1234567890

MAX_ALLOWED_STREAMS=4
ENCRYPT_RESULTS=true

RESULTS_INTERVAL=1000
FACE_DETECTION_CONFIDENCE=0.9
FACE_DETECTOR_RESOLUTION=640
MAX_ALLOWED_DETECTIONS=50
MAX_FRAME_RESOLUTION=1280
MAX_CROPPED_FACE_RESOLUTION=224
FRAME_TO_RETURN="none"
STREAMING_FPS=8
CAMERA_RECONNECT_INTERVAL=10
CAMERA_RECONNECT_ATTEMPTS=5

# --- MediaMTX controller (config API) ---
MTX_ENABLE=true
MTX_TIMEOUT_SEC=5
MTX_RETRY_COUNT=2
MTX_ADD_PATH=v3/config/paths/add/
MTX_DELETE_PATH=v3/config/paths/delete/
MTX_LIST_PATH=v3/config/paths/list/

# --- Auth (pick one flow) ---
# Basic auth (recommended if controller is private)
# MTX_USERNAME=plain-username
# MTX_PASSWORD=plain-password

# OR: Bearer token (static)
# MTX_BEARER_TOKEN=eyJhbGciOi...

# OR: Fetch bearer token by POSTing with Basic to this URL; expect {"token": "..."} or {"access_token": "..."}
# MTX_AUTH_URL=http://auth.local/token
# MTX_AUTH_FETCH=true

# --- Optional: if your creds are stored encrypted elsewhere and you decrypt at runtime ---
# MTX_ENC_USERNAME=...
# MTX_ENC_PASSWORD=...