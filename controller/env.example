# ---- Mongo ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=controller

# ---- API keys (use long, random values in prod) ----
WORKER_API_KEY=worker-api-key-1234567890

# ---- Token verification ----
# For local development run tools/dev-token-server (listens on :9000).
TOKEN_VERIFICATION_ENABLED=true
TOKEN_VERIFICATION_URL=http://localhost:9000/token/verify

# ---- Networking ----
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=2

# ---- Notifications ----
WS_PING_INTERVAL_SECONDS=20
WS_SEND_QUEUE_SIZE=100
# REDIS_URL=redis://localhost:6379/0   # uncomment when you scale horizontally